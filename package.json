{
  "name": "restoran-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Modern Restoran POS Sistemi",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "npm run build --prefix client",
    "start:prod": "cross-env NODE_ENV=production node server/index.js",
    "prod": "npm run build && npm run start:prod",
    "server": "cd server && node index.js",
    "client": "cd client && npx vite --host",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "db:migrate": "cd server && node migrations/run.js",
    "db:seed": "cd server && node seeds/run.js",
    "debug:login": "cd server && node test-login.js",
    "setup": "npm install && cd server && npm install && cd ../client && npm install && cd .. && npm run db:seed",
    "bridge": "node ./store-bridge/index.js",
    "app:start": "npm run dev",
    "bridge:start": "npm run bridge",
    "callerid:start": "dotnet run --project ./tools/callerid-sdk-helper/CallerIdSdkHelper.csproj -- --post-enabled true",
    "all:start": "scripts\\start-all.bat",
    "electron": "electron .",
    "electron:prod": "npm run build && electron ."
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0"
  }
}
