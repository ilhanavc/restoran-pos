{
  "name": "restoran-pos",
  "version": "1.0.9",
  "private": true,
  "description": "Modern Restoran POS Sistemi",
  "author": "Restoran POS",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "npm run build --prefix client",
    "server": "cd server && node index.js",
    "client": "cd client && npx vite --host",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "npm run test --prefix server",
    "test:frontend": "npm run test --prefix client",
    "test:all": "npm run test --prefix server && npm run test --prefix client",
    "test:watch": "npm run test:watch --prefix server",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "lint": "npm run lint:warn --prefix client",
    "lint:ci": "npm run lint:ci --prefix client",
    "db:migrate": "cd server && node migrations/run.js",
    "db:seed": "cd server && node seeds/run.js",
    "setup": "npm install && cd server && npm install && cd ../client && npm install && cd .. && npm run db:seed",
    "prod": "npm run build && cross-env NODE_ENV=production node server/index.js",
    "start:prod": "cross-env NODE_ENV=production node server/index.js",
    "electron:prod": "npm run build && electron .",
    "bridge": "node ./store-bridge/index.js",
    "callerid:start": "dotnet run --project ./tools/callerid-sdk-helper/CallerIdSdkHelper.csproj -- --post-enabled true",
    "build:callerid-helper": "node scripts/build-callerid-helper.cjs",
    "desktop:preflight": "node scripts/check-desktop-release.cjs",
    "all:start": "scripts\\start-all.bat",
    "electron": "electron .",
    "clean:server-sqlite-build": "node scripts/clean-server-sqlite-build.cjs",
    "rebuild:server-native": "npm run clean:server-sqlite-build && node scripts/rebuild-server-native.cjs",
    "rebuild:server-native:source": "cross-env FORCE_SQLITE_BUILD_FROM_SOURCE=1 npm run rebuild:server-native",
    "smoke:electron-sqlite": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-electron-sqlite.cjs",
    "smoke:server-health": "node scripts/smoke-server-health.cjs",
    "postinstall": "node scripts/rebuild-server-native.cjs",
    "dist": "npm install --prefix server && npm run rebuild:server-native && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never",
    "dist:prepare": "npm run build && npm install --prefix server --omit=dev && npm install --prefix store-bridge --omit=dev && npm run build:callerid-helper && npm run rebuild:server-native && npm run smoke:electron-sqlite && npm run smoke:server-health && npm run desktop:preflight && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir --publish never",
    "dist:nsis": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --prepackaged dist-electron/win-unpacked --win nsis --publish never",
    "dist:portable": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --prepackaged dist-electron/win-unpacked --win portable --publish never",
    "dist:win": "npm run dist:prepare && npm run dist:nsis && npm run dist:portable",
    "dist:win:dir": "npm run dist:prepare",
    "dist:win:nsis": "npm run dist:nsis",
    "dist:win:portable": "npm run dist:portable",
    "dist:gen-update-meta": "node scripts/gen-update-meta.cjs",
    "dist:release": "npm run dist:win && npm run dist:gen-update-meta"
  },
  "build": {
    "appId": "com.restoranpos.desktop",
    "productName": "Restoran POS",
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!data",
          "!data/**/*",
          "!.env",
          "!.env.*",
          "!.env.local",
          "!test-login.js",
          "!node_modules/restoran-pos",
          "!node_modules/restoran-pos/**/*",
          "!**/node_modules/**/*.md",
          "!**/node_modules/**/LICENSE",
          "!**/node_modules/**/LICENSE.*",
          "!**/node_modules/**/CHANGELOG*",
          "!**/node_modules/**/README*",
          "!**/*.map"
        ]
      },
      {
        "from": "store-bridge",
        "to": "store-bridge",
        "filter": [
          "**/*",
          "!**/node_modules/**/*.md",
          "!**/node_modules/**/LICENSE",
          "!**/node_modules/**/LICENSE.*",
          "!**/node_modules/**/CHANGELOG*",
          "!**/node_modules/**/README*",
          "!**/*.map"
        ]
      },
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*",
          "!**/bin/",
          "!**/obj/"
        ]
      },
      {
        "from": "tools/callerid-sdk-helper/bin/Release/net8.0",
        "to": "tools/callerid-sdk-helper/bin/Release/net8.0",
        "filter": [
          "**/*",
          "!*.pdb"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ilhanavc",
      "repo": "restoran-pos",
      "private": false
    },
    "npmRebuild": false,
    "compression": "store",
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "warningsAsErrors": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "compression": "store",
      "signAndEditExecutable": false,
      "signDlls": false
    }
  },
  "dependencies": {
    "@sentry/electron": "^7.11.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.55.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3"
  }
}
