{
  "_talimat": "Bu dosyayı 'pos-config.json' olarak kopyalayın ve değerleri doldurun. Electron açılışında otomatik okunur.",

  "port": 3001,
  "cloudServerUrl": "",
  "jwtSecret": "GIZLI_JWT_ANAHTARI_BURAYA_DEGISTIRIN",

  "_corsAciklama": "LAN'dan erişen tablet/cihaz origin'lerini buraya ekleyin. Boş bırakılırsa sadece localhost kabul edilir.",
  "corsOrigins": [],

  "bridge": {
    "_aciklama": "Store Bridge (yazıcı + arayanı tanıma) ayarları",
    "token": "BRIDGE_TOKEN_BURAYA",
    "businessId": 1,
    "dryRun": false,
    "pollIntervalMs": 2000,
    "apiTimeoutMs": 8000,
    "healthRetryMs": 3000,
    "socketTimeoutMs": 8000,
    "claimId": "store-bridge",
    "printEncodingMode": "win1254",
    "printEscT": 32
  },

  "callerid": {
    "_aciklama": "CID812 arayanı tanıma cihazı ayarları",
    "enabled": true,
    "mode": "hid",
    "_mode_secenekleri": "hid | clipboard",
    "_mode_hid": "USB HID cihazdan doğrudan okuma (önerilen)",
    "_mode_clipboard": "Pasif mod — harici script numarayı /api/bridge/caller-id/incoming endpointine gönderir",

    "enableParse": true,
    "phoneRegex": "(?:0|\\+90)?\\s*(5\\d{2}[\\s\\-]?\\d{3}[\\s\\-]?\\d{2}[\\s\\-]?\\d{2})",
    "debounceMs": 3500,
    "postRetryAttempts": 3,
    "postRetryMs": 1500,
    "postQueueMax": 25,

    "hid": {
      "_aciklama": "USB HID filtre — scan-hid-devices.js ile bulunur",
      "vid": "C0F4",
      "pid": "01F5",
      "serial": "",
      "reconnectIntervalMs": 5000
    }
  }
}
