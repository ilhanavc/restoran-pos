PORT=3001
HOST=0.0.0.0
USER_DATA_PATH=/data
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,https://your-app.railway.app
BRIDGE_TOKEN=change-me-in-production
NODE_ENV=production
# Reverse proxy hop sayısı. 0 = doğrudan, 1 = Nginx, 2 = Cloudflare + Nginx.
TRUST_PROXY_HOPS=1
# Global rate-limit: IP başına pencere süresi (ms) ve maksimum istek sayısı.
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

# Sentry (hata + performans izleme). DSN boşsa Sentry init atlanır (no-op).
# Kurulum rehberi: docs/runbooks/sentry-setup-runbook.md
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=restoran-pos@1.0.9
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
