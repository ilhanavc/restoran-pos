# Client (Vite) env — VITE_ prefix'i ile başlayanlar client bundle'ına gömülür.
# Sadece PUBLIC değerler olmalı — secret asla client'a gömülmez.
# Kurulum rehberi: docs/runbooks/sentry-setup-runbook.md

# Backend API URL (cloud mode veya farklı host için). Boşsa localhost:3001 fallback.
VITE_API_URL=

# Sentry (frontend hata + performans + session replay). DSN boşsa init atlanır.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=restoran-pos@1.0.9
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Build-time only (bundle'a girmez). Source map upload için vite build sırasında okunur.
# Auth token asla commit'lenmez — sadece CI/CD runner veya .env dosyasında kalır.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
